# Copy this file to .env.local and fill in the key. Never commit .env.local.

# Key for the Intela LLM gateway (self-hosted Qwen). Leave empty to use the rule-based fallback.
JANUS_API_KEY=

# OpenAI-compatible gateway and model
LLM_BASE_URL=https://llm.intela.cloud/v1
LLM_MODEL=qwen3.6-35b-a3b

# SQLite database file for local development
DATABASE_URL="file:./dev.db"
